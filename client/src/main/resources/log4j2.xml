<?xml version="1.0" encoding="utf-8"?>
<Configuration status="WARN">
<Appenders>
    <!-- Отключаем консольный аппендер, комментируя его -->
    <!-- <Console name="Console" target="SYSTEM_OUT">
        <PatternLayout charset="UTF-8" pattern="%d{yyyy-MM-dd HH:mm:ss} %-5p %c{1}:%L - %msg%n" />
    </Console> -->

    <!-- Файловый аппендер для записи логов в файл -->
    <File name="File" fileName="logs/app.log" append="false">
        <PatternLayout charset="UTF-8" pattern="%d{yyyy-MM-dd HH:mm:ss} %-5p %c{1}:%L - %msg%n" />
    </File>
</Appenders>

<Loggers>
    <Root level="debug">
        <!-- Убираем ссылку на Console аппендер -->
        <!-- <AppenderRef ref="Console" /> -->
        <AppenderRef ref="File" />
    </Root>
</Loggers>
</Configuration>

